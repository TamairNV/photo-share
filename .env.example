# Folder on the server's hard drive where events/photos live
PHOTOS_PATH=/mnt/fpv2tb/event-photos
# Password for /admin (only used when AUTH_MODE=password)
ADMIN_PASSWORD=change-me
# Random string so logins survive restarts: openssl rand -hex 32
SECRET_KEY=
# Public URL (used for share links and QR codes)
BASE_URL=https://share.tamairnv.co.uk
SITE_NAME=Tamair's Photos
# Label for photos you add yourself (admin upload or rsync)
OWNER_NAME=Tamair
# Used to build the "copy with rsync" command in the admin panel
SSH_TARGET=tnv@192.168.1.199
# Your user/group id on the server (run `id` to check). The app writes files as this user.
PUID=1000
PGID=1000
TZ=Europe/London

# --- Admin login ---
# password   = built-in login page using ADMIN_PASSWORD
# cloudflare = no login page; trust Cloudflare Access protecting /admin* (JWT is verified)
AUTH_MODE=cloudflare
# Zero Trust dashboard > Settings > Custom pages shows your team domain
CF_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# Zero Trust > Access > Applications > (your app) > Overview > Application Audience (AUD) Tag
CF_AUD=
# Optional extra check: only these emails count as admin (comma separated)
ADMIN_EMAILS=
